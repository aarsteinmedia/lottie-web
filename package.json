{
  "name": "@aarsteinmedia/lottie-web",
  "version": "1.5.10",
  "description": "Play animations generated in After Effects in the browser",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lottie.d.ts",
      "default": "./dist/lottie.js"
    },
    "./light": {
      "types": "./dist/lottie-light.d.ts",
      "default": "./dist/lottie-light.js"
    },
    "./svg": {
      "types": "./dist/lottie-svg.d.ts",
      "default": "./dist/lottie-svg.js"
    },
    "./canvas": {
      "types": "./dist/lottie-canvas.d.ts",
      "default": "./dist/lottie-canvas.js"
    },
    "./utils": {
      "types": "./dist/lottie-utils.d.ts",
      "default": "./dist/lottie-utils.js"
    },
    "./dotlottie": {
      "types": "./dist/dotlottie.d.ts",
      "default": "./dist/dotlottie.js"
    }
  },
  "main": "./dist/lottie.js",
  "types": "./dist/lottie.d.ts",
  "homepage": "https://www.aarstein.media/en/dotlottie-player",
  "repository": {
    "url": "git+https://github.com/aarsteinmedia/lottie-web.git",
    "type": "git"
  },
  "bugs": "https://github.com/aarsteinmedia/lottie-web/issues",
  "author": {
    "name": "Johan Martin Aarstein",
    "email": "johan@aarstein.media",
    "url": "https://www.aarstein.media",
    "organization": "Aarstein Media"
  },
  "contributors": [
    {
      "name": "KoloMl",
      "email": "thekolomoets@hotmail.com",
      "url": "https://github.com/koloml"
    }
  ],
  "license": "GPL-2.0-or-later",
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "rollup -c --configPlugin @rollup/plugin-typescript",
    "prebuild:types": "rimraf ./types ",
    "build:types": "tsc -p tsconfig.build.json && tsc-alias",
    "prod": "pnpm build:types && pnpm build",
    "assets": "node preview/writeFiles.ts",
    "predev": "pnpm assets",
    "dev": "rollup -cw --configPlugin @rollup/plugin-typescript --environment NODE_ENV:development",
    "lint": "eslint ./src ./tests",
    "lint:fix": "eslint ./src ./tests --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build": "vitest run tests/build.test.ts",
    "check": "pnpm lint && pnpm test && pnpm prod && pnpm test:build",
    "deploy": "npm publish"
  },
  "peerDependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@aarsteinmedia/dotlottie-player": "^6.4.9",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.5.1",
    "eslint": "^9.39.5",
    "eslint-config-sheriff": "^31.4.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "fflate": "^0.8.3",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.2",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-opener": "^0.2.4",
    "rollup-plugin-summary": "^3.0.1",
    "rollup-plugin-swc3": "^0.12.1",
    "rollup-plugin-typescript-paths": "^1.5.0",
    "tsc-alias": "^1.9.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vitest-canvas-mock": "^1.2.0"
  },
  "browserslist": {
    "production": [
      "defaults",
      ">0.3%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "lottie",
    "animation",
    "svg",
    "vector",
    "player"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "funding": {
    "type": "paypal",
    "url": "https://www.paypal.me/aarsteinmedia"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
